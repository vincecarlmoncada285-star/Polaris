# Local SQLite database. Switch the Prisma provider to PostgreSQL for serverless hosting.
DATABASE_URL="file:./dev.db"

# Auth.js signs and encrypts session cookies with this. Required.
# Generate one with `npx auth secret` or `openssl rand -base64 32`. Never commit a real one.
AUTH_SECRET=""

# Trust the Host / X-Forwarded-Host headers. Needed for `next start` and when self-hosting
# behind a reverse proxy (nginx, Caddy, a load balancer). Only set it if that proxy overwrites
# those headers; otherwise set AUTH_URL to the public URL instead.
AUTH_TRUST_HOST=true

# Rate limits on sign-in and sign-up are partly per client IP. Without a reverse proxy, the
# X-Forwarded-For header comes straight from the client and can be forged, so Polaris ignores it
# and all clients share one per-IP allowance. Behind proxies that append the client address to
# X-Forwarded-For (nginx's $proxy_add_x_forwarded_for, Caddy, most load balancers), set this to
# how many there are (usually 1). Never set it if clients can also reach Polaris directly.
TRUSTED_PROXY_HOPS=0

# Phase 3: LLM-powered suggestions. Never commit a real key.
ANTHROPIC_API_KEY=""
