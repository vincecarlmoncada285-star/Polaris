{
  "name": "polaris",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node -e \"require('fs').rmSync('prisma/e2e.db',{force:true})\" && DATABASE_URL=file:./e2e.db prisma db push --skip-generate && DATABASE_URL=file:./e2e.db playwright test",
    "db:push": "prisma db push",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@prisma/client": "^6.16.2",
    "@tiptap/core": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "bcryptjs": "3.0.3",
    "docx": "9.11.0",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "marked": "18.1.1",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.2.3",
    "prettier": "^3.6.2",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
