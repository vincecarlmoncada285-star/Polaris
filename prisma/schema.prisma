generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  // Stored trimmed and lowercased (see src/lib/users/schema.ts).
  email        String     @unique
  name         String?
  passwordHash String
  // Opt-in: AI suggestions send paragraph text to the Claude API.
  aiEnabled    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  documents    Document[]
}

model Document {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("Untitled document")
  // TipTap/ProseMirror JSON, serialized.
  content   String   @default("{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\"}]}")
  plainText String   @default("")
  wordCount Int      @default(0)
  // Writing goals (audience, citation style, etc.), serialized JSON.
  goals     String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}
